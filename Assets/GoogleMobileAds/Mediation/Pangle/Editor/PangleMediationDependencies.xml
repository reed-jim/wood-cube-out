<dependencies>
  <androidPackages>
    <androidPackage spec="com.google.ads.mediation:pangle:8.0.0.5.0">
      <repositories>
        <repository>https://repo.maven.apache.org/maven2/</repository>
        <repository>https://dl.google.com/dl/android/maven2/</repository>
        <repository>https://artifact.bytedance.com/repository/pangle/</repository>
      </repositories>
    </androidPackage>
  </androidPackages>

  <iosPods>
    <!-- 7.9.1.1.1 needs Ads-Global 7.9.1.1 + GMA "~> 13.3.0" — the newest Pangle adapter
         that still accepts GMA 13.3.x. Paired with MAX's ByteDance adapter 7.9.1.1.0,
         which pins the same Ads-Global 7.9.1.1. Moving to 8.2.0.8.0 would force GMA
         "~> 13.6" and break the 13.3.0 alignment. -->
    <iosPod name="GoogleMobileAdsMediationPangle" version="7.9.1.1.1"/>
  </iosPods>
</dependencies>
