MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8343067938292222626}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Log in for 7 days to unlock a special chest!
    Object: {fileID: 0}
  - Language: French
    Text: "Connectez-vous pendant 7 jours pour d\xE9bloquer un coffre sp\xE9cial!"
    Object: {fileID: 0}
  - Language: German
    Text: Melden Sie sich 7 Tage lang an, um eine besondere Truhe freizuschalten!
    Object: {fileID: 0}
  - Language: Italian
    Text: Accedi per 7 giorni per sbloccare un petto speciale!
    Object: {fileID: 0}
  - Language: Japanese
    Text: "\u7279\u5225\u306A\u30C1\u30A7\u30B9\u30C8\u306E\u30ED\u30C3\u30AF\u3092\u89E3\u9664\u3059\u308B\u305F\u3081\u306B7\u65E5\u9593\u30ED\u30B0\u30A4\u30F3\u3057\u3066\u304F\u3060\u3055\u3044\uFF01"
    Object: {fileID: 0}
  - Language: Korean
    Text: "\uD2B9\uBCC4\uD55C \uAC00\uC2B4\uC744 \uC7A0\uAE08 \uD574\uC81C\uD558\uB824\uBA74
      7 \uC77C \uB3D9\uC548 \uB85C\uADF8\uC778\uD558\uC2ED\uC2DC\uC624!"
    Object: {fileID: 0}
  - Language: Portuguese
    Text: "Fa\xE7a login por 7 dias para desbloquear um ba\xFA especial!"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0412\u043E\u0439\u0434\u0438\u0442\u0435 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      7 \u0434\u043D\u0435\u0439, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043E\u0441\u043E\u0431\u044B\u0439 \u0441\u0443\u043D\u0434\u0443\u043A!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xA1Inicie sesi\xF3n durante 7 d\xEDas para desbloquear un cofre especial!"
    Object: {fileID: 0}
