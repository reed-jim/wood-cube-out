  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Collect {value} more gems to unlock your next reward!
    Object: {fileID: 0}
  - Language: French
    Text: "Collectez {value} Plus de gemmes pour d\xE9verrouiller votre prochaine
      r\xE9compense!"
    Object: {fileID: 0}
  - Language: German
    Text: "Sammeln Sie {value} mehr Edelsteine, um Ihre n\xE4chste Belohnung freizuschalten!"
    Object: {fileID: 0}
  - Language: Italian
    Text: "Raccogli {value} pi\xF9 gemme per sbloccare la tua prossima ricompensa!"
    Object: {fileID: 0}
  - Language: Japanese
    Text: "{value}\u3092\u53CE\u96C6\u3057\u3066\u3001\u6B21\u306E\u5831\u916C\u306E\u30ED\u30C3\u30AF\u3092\u89E3\u9664\u3057\u3066\u304F\u3060\u3055\u3044\uFF01"
    Object: {fileID: 0}
  - Language: Korean
    Text: "\uB2E4\uC74C \uBCF4\uC0C1\uC744 \uC7A0\uAE08 \uD574\uC81C\uD558\uAE30
      \uC704\uD574 {value} \uB354 \uB9CE\uC740 \uBCF4\uC11D\uC744 \uC218\uC9D1\uD558\uC2ED\uC2DC\uC624!"
    Object: {fileID: 0}
  - Language: Portuguese
    Text: "Colete {value} Mais gemas para desbloquear sua pr\xF3xima recompensa!"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435 {value} \u0431\u043E\u043B\u044C\u0448\u0435
      \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u044B\u0445 \u043A\u0430\u043C\u043D\u0435\u0439,
      \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E \u043D\u0430\u0433\u0440\u0430\u0434\u0443!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xA1Recopile {value} m\xE1s gemas para desbloquear su pr\xF3xima recompensa!"
    Object: {fileID: 0}
