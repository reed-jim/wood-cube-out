  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Reach <color=#FAE143>level {level}</color> to open!
    Object: {fileID: 0}
  - Language: French
    Text: Atteignez le niveau <color=#FAE143>{level}</color> pour ouvrir!
    Object: {fileID: 0}
  - Language: German
    Text: "Level <color=#FAE143>{level}</color> zu \xF6ffnen!"
    Object: {fileID: 0}
  - Language: Italian
    Text: Raggiungi il livello <color=#FAE143>{level}</color> per aprire!
    Object: {fileID: 0}
  - Language: Japanese
    Text: "\u5230\u9054\u30EC\u30D9\u30EB<color=#FAE143>{level}</color>\u3092\u958B\u304F\uFF01"
    Object: {fileID: 0}
  - Language: Korean
    Text: "\uB808\uBCA8\uC5D0 \uB3C4\uB2EC <color=#FAE143>{level}</color>\uC744 \uC5F4\uB824\uBA74!"
    Object: {fileID: 0}
  - Language: Portuguese
    Text: "N\xEDvel de alcance <color=#FAE143>{level}</color> para abrir!"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0414\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u044C \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      <color=#FAE143>{level}</color>, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: Level de alcance <color=#FAE143>{level}</color> para abrir!
    Object: {fileID: 0}
