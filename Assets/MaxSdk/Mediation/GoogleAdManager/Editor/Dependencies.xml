<?xml version="1.0" encoding="utf-8"?>
<dependencies>
    <androidPackages>
        <!-- Ensure that Resolver doesn't inadvertently pull the latest Play Services Ads' SDK that we haven't certified against. -->
        <androidPackage spec="com.applovin.mediation:google-ad-manager-adapter:[25.4.0.0]" />
    </androidPackages>
    <iosPods>
        <!-- Held at 13.3.0.0 (requires Google-Mobile-Ads-SDK = 13.3.0) to match the
             Google adapter above; both must agree on the same GMA SDK version. -->
        <iosPod name="AppLovinMediationGoogleAdManagerAdapter" version="13.3.0.0" />
    </iosPods>
</dependencies>
