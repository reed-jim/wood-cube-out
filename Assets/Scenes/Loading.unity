  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Click any object to break it!
    Object: {fileID: 0}
  - Language: French
    Text: "Cliquez sur n'importe quel objet pour le casser\_!"
    Object: {fileID: 0}
  - Language: German
    Text: "Klicken Sie auf ein beliebiges Objekt, um es zu zerst\xF6ren!"
    Object: {fileID: 0}
  - Language: Italian
    Text: Fare clic su qualsiasi oggetto per romperlo!
    Object: {fileID: 0}
  - Language: Japanese
    Text: "\u30AA\u30D6\u30B8\u30A7\u30AF\u30C8\u3092\u30AF\u30EA\u30C3\u30AF\u3057\u3066\u7834\u58CA\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
    Object: {fileID: 0}
  - Language: Korean
    Text: "\uADF8\uAC83\uC744 \uAE68\uB824\uBA74 \uAC1C\uCCB4\uB97C \uD074\uB9AD\uD558\uC2ED\uC2DC\uC624!"
    Object: {fileID: 0}
  - Language: Portuguese
    Text: "Clique em qualquer objeto para quebr\xE1-lo!"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u043B\u044E\u0431\u043E\u0439
      \u043E\u0431\u044A\u0435\u043A\u0442, \u0447\u0442\u043E\u0431\u044B \u0441\u043B\u043E\u043C\u0430\u0442\u044C
      \u0435\u0433\u043E!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xA1Haz clic en cualquier objeto para romperlo!"
    Object: {fileID: 0}
