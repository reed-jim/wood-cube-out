  data: 0
  entries:
  - Language: English
    Text: The space race is underway!
    Object: {fileID: 0}
  - Language: French
    Text: La course spatiale est en cours!
    Object: {fileID: 0}
  - Language: German
    Text: Das Weltraumrennen ist im Gange!
    Object: {fileID: 0}
  - Language: Italian
    Text: "La gara di spazio \xE8 in corso!"
    Object: {fileID: 0}
  - Language: Japanese
    Text: "\u5B87\u5B99\u30EC\u30FC\u30B9\u304C\u9032\u884C\u4E2D\u3067\u3059\uFF01"
    Object: {fileID: 0}
  - Language: Korean
    Text: "\uC6B0\uC8FC \uACBD\uC8FC\uAC00 \uC9C4\uD589 \uC911\uC785\uB2C8\uB2E4!"
    Object: {fileID: 0}
  - Language: Portuguese
    Text: "A corrida espacial est\xE1 em andamento!"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u041A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0433\u043E\u043D\u043A\u0430
      \u0438\u0434\u0435\u0442!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xA1La carrera espacial est\xE1 en marcha!"
    Object: {fileID: 0}
