  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: This will overwrite your cloud data. Are you sure?
    Object: {fileID: 0}
  - Language: French
    Text: "Cela \xE9crasera vos donn\xE9es cloud. "
    Object: {fileID: 0}
  - Language: German
    Text: "Dadurch \xFCberschreiben Sie Ihre Cloud -Daten. "
    Object: {fileID: 0}
  - Language: Italian
    Text: "Questo sovrascriver\xE0 i tuoi dati cloud. "
    Object: {fileID: 0}
  - Language: Japanese
    Text: "\u3053\u308C\u306B\u3088\u308A\u3001\u30AF\u30E9\u30A6\u30C9\u30C7\u30FC\u30BF\u304C\u4E0A\u66F8\u304D\u3055\u308C\u307E\u3059\u3002"
    Object: {fileID: 0}
  - Language: Korean
    Text: "\uD074\uB77C\uC6B0\uB4DC \uB370\uC774\uD130\uB97C \uB36E\uC5B4 \uC4F8
      \uAC83\uC785\uB2C8\uB2E4. "
    Object: {fileID: 0}
  - Language: Portuguese
    Text: "Isso substituir\xE1 seus dados em nuvem. "
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u042D\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0438\u0441\u0430\u0442\u044C
      \u0432\u0430\u0448\u0438 \u043E\u0431\u043B\u0430\u0447\u043D\u044B\u0435 \u0434\u0430\u043D\u043D\u044B\u0435. "
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Esto sobrescribir\xE1 sus datos en la nube. "
    Object: {fileID: 0}
