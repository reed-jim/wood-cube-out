--- !u!114 &8290667632231828480
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5437777869188171086}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: If you have any issues with the backup, please contact us.
    Object: {fileID: 0}
  - Language: French
    Text: "Si vous avez des probl\xE8mes avec la sauvegarde, veuillez nous contacter."
    Object: {fileID: 0}
  - Language: German
    Text: Wenn Sie Probleme mit der Sicherung haben, kontaktieren Sie uns bitte.
    Object: {fileID: 0}
  - Language: Italian
    Text: Se hai problemi con il backup, contattaci.
    Object: {fileID: 0}
  - Language: Japanese
    Text: "\u30D0\u30C3\u30AF\u30A2\u30C3\u30D7\u306B\u554F\u984C\u304C\u3042\u308B\u5834\u5408\u306F\u3001\u304A\u554F\u3044\u5408\u308F\u305B\u304F\u3060\u3055\u3044\u3002"
    Object: {fileID: 0}
  - Language: Korean
    Text: "\uBC31\uC5C5\uC5D0 \uBB38\uC81C\uAC00 \uC788\uC73C\uC2DC\uBA74 \uBB38\uC758\uD558\uC2ED\uC2DC\uC624."
    Object: {fileID: 0}
  - Language: Portuguese
    Text: "Se voc\xEA tiver algum problema com o backup, entre em contato conosco."
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0415\u0441\u043B\u0438 \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C
      \u043A\u0430\u043A\u0438\u0435 -\u043B\u0438\u0431\u043E \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B
      \u0441 \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u043E\u0439 \u043A\u043E\u043F\u0438\u0435\u0439,
      \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0441\u0432\u044F\u0436\u0438\u0442\u0435\u0441\u044C
      \u0441 \u043D\u0430\u043C\u0438."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Si tiene alg\xFAn problema con la copia de seguridad, cont\xE1ctenos."
    Object: {fileID: 0}
