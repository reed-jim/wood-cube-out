  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: English
    Text: Suggest a card that matches the theme of the ordered slot
    Object: {fileID: 0}
  - Language: French
    Text: "Sugg\xE9rer une carte correspondant au th\xE8me de l'emplacement command\xE9"
    Object: {fileID: 0}
  - Language: German
    Text: Schlagen Sie eine Karte vor, die zum Thema des bestellten Slots passt
    Object: {fileID: 0}
  - Language: Italian
    Text: Suggerisci una carta che corrisponda al tema dello slot ordinato
    Object: {fileID: 0}
  - Language: Japanese
    Text: "\u6CE8\u6587\u3057\u305F\u30B9\u30ED\u30C3\u30C8\u306E\u30C6\u30FC\u30DE\u306B\u5408\u3063\u305F\u30AB\u30FC\u30C9\u3092\u63D0\u6848\u3057\u307E\u3059"
    Object: {fileID: 0}
  - Language: Korean
    Text: "\uC8FC\uBB38\uD55C \uC2AC\uB86F\uC758 \uD14C\uB9C8\uC5D0 \uB9DE\uB294
      \uCE74\uB4DC\uB97C \uCD94\uCC9C\uD574\uC8FC\uC138\uC694"
    Object: {fileID: 0}
  - Language: Portuguese
    Text: "Sugira um cart\xE3o que corresponda ao tema do slot solicitado"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u0435 \u043A\u0430\u0440\u0442\u0443,
      \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0443\u044E
      \u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435 \u0437\u0430\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0433\u043E
      \u0441\u043B\u043E\u0442\u0430"
    Object: {fileID: 0}
  - Language: Spanish
    Text: Sugiera una tarjeta que coincida con el tema de la tragamonedas solicitada.
    Object: {fileID: 0}
