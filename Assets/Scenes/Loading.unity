  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: English
    Text: No Shuffle Available!
    Object: {fileID: 0}
  - Language: French
    Text: "Aucune lecture al\xE9atoire disponible\_!"
    Object: {fileID: 0}
  - Language: German
    Text: "Keine Zufallswiedergabe verf\xFCgbar!"
    Object: {fileID: 0}
  - Language: Italian
    Text: Nessuna riproduzione casuale disponibile!
    Object: {fileID: 0}
  - Language: Japanese
    Text: "\u30B7\u30E3\u30C3\u30D5\u30EB\u306F\u5229\u7528\u3067\u304D\u307E\u305B\u3093!"
    Object: {fileID: 0}
  - Language: Korean
    Text: "\uC154\uD50C\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4!"
    Object: {fileID: 0}
  - Language: Portuguese
    Text: "N\xE3o h\xE1 embaralhamento dispon\xEDvel!"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u041F\u0435\u0440\u0435\u043C\u0435\u0448\u0438\u0432\u0430\u043D\u0438\u0435
      \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xA1No hay reproducci\xF3n aleatoria disponible!"
    Object: {fileID: 0}
