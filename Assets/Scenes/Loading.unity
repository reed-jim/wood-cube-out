  entries:
  - Language: English
    Text: Please try again!
    Object: {fileID: 0}
  - Language: French
    Text: "Veuillez r\xE9essayer!"
    Object: {fileID: 0}
  - Language: German
    Text: Bitte versuchen Sie es erneut!
    Object: {fileID: 0}
  - Language: Italian
    Text: Per favore riprova!
    Object: {fileID: 0}
  - Language: Japanese
    Text: "\u3082\u3046\u4E00\u5EA6\u3084\u308A\u76F4\u3057\u3066\u304F\u3060\u3055\u3044\uFF01"
    Object: {fileID: 0}
  - Language: Korean
    Text: "\uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC2ED\uC2DC\uC624!"
