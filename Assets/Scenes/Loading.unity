    Object: {fileID: 0}
  - Language: Russian
    Text: "\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u0435\u0449\u0435 \u0440\u0430\u0437!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xA1Vuelve a intentarlo!"
    Object: {fileID: 0}
