  data: 0
  entries:
  - Language: English
    Text: Hold to see the board
    Object: {fileID: 0}
  - Language: French
    Text: Attendez pour voir le tableau
    Object: {fileID: 0}
  - Language: German
    Text: "Halten Sie gedr\xFCckt, um die Tafel anzuzeigen"
    Object: {fileID: 0}
  - Language: Italian
    Text: Tieni premuto per vedere il tabellone
    Object: {fileID: 0}
  - Language: Japanese
    Text: "\u62BC\u3057\u7D9A\u3051\u308B\u3068\u30DC\u30FC\u30C9\u304C\u8868\u793A\u3055\u308C\u307E\u3059"
    Object: {fileID: 0}
  - Language: Korean
    Text: "\uBCF4\uB4DC\uB97C \uBCF4\uB824\uBA74 \uAE38\uAC8C \uB204\uB974\uC138\uC694."
    Object: {fileID: 0}
  - Language: Portuguese
    Text: Segure para ver o quadro
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
      \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0434\u043E\u0441\u043A\u0443"
    Object: {fileID: 0}
  - Language: Spanish
    Text: Mantenga presionado para ver el tablero
    Object: {fileID: 0}
