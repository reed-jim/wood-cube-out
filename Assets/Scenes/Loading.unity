  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Click the screw to return to the box.
    Object: {fileID: 0}
  - Language: French
    Text: "Cliquez sur la vis pour revenir \xE0 la bo\xEEte."
    Object: {fileID: 0}
  - Language: German
    Text: "Klicken Sie auf die Schraube, um zur Box zur\xFCckzukehren."
    Object: {fileID: 0}
  - Language: Italian
    Text: Fare clic sulla vite per tornare alla casella.
    Object: {fileID: 0}
  - Language: Japanese
    Text: "\u30CD\u30B8\u3092\u30AF\u30EA\u30C3\u30AF\u3057\u3066\u30DC\u30C3\u30AF\u30B9\u306B\u623B\u308A\u307E\u3059\u3002"
    Object: {fileID: 0}
  - Language: Korean
    Text: "\uC0C1\uC790\uB85C \uB3CC\uC544\uAC00\uB824\uBA74 \uB098\uC0AC\uB97C \uD074\uB9AD\uD558\uC138\uC694."
    Object: {fileID: 0}
  - Language: Portuguese
    Text: "Clique no parafuso para retornar \xE0 caixa."
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u0432\u0438\u043D\u0442,
      \u0447\u0442\u043E\u0431\u044B \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0432 \u043A\u043E\u0440\u043E\u0431\u043A\u0443."
    Object: {fileID: 0}
  - Language: Spanish
    Text: Haga clic en el tornillo para regresar a la caja.
    Object: {fileID: 0}
