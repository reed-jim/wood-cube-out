using System;
using PlayFab;
using PlayFab.ClientModels;
using UnityEngine;
using UnityEngine.UI;

public class SuggetLoginPvPBox : BaseBox
{
    public void Init()
    {
        btnClose.onClick.AddListener(() => ClosePopUp(null));
        btnLoginFB.onClick.AddListener(() => GameController.Instance.loginController.Login(TypeLogin.FB));
        btnLoginGG.onClick.AddListener(() => GameController.Instance.loginController.Login(TypeLogin.GG));
        btnConfirm.onClick.AddListener(() => HandleButtonConfirm());
        if (UseProfile.NamePlayer == "Bird#" + GetLastFiveCharOfId(UseProfile.PlayFabId))
        {
            ipfName.gameObject.SetActive(true);
            btnConfirm.gameObject.SetActive(true);
        }
        else
        {
            ipfName.gameObject.SetActive(false);
            btnConfirm.gameObject.SetActive(false);
        }
    }


    public void InitState(Action close)
    {
        EvtClose = null;
        EvtClose = close;

        actionCloseEvent = ClosePopUp;
        EventDispatcher.EventDispatcher.Instance.RegisterListener(EventID.ON_LOGIN_GG_OR_FB_COMPLETE, actionCloseEvent);
    }

    private void ClosePopUp(object param)
    {
        EvtClose?.Invoke();
        Close();
